<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>3D Campus Embedded Screen</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #1a1a1a;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        /* Continuous Render Containers */
        #container3d, #containerCss {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
        #containerCss {
            pointer-events: none; /* Let OrbitControls work on background */
        }

        /* 3D Surface Interface Style */
        .yt-3d-screen {
            width: 1280px;
            height: 720px;
            background: #0f0f0f;
            color: #ffffff;
            border: 4px solid #333;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-shadow: 0 0 50px rgba(0,0,0,0.8);
            pointer-events: auto; /* Enable touch/click directly on the 3D screen surface */
            user-select: text;
        }

        /* YouTube Inner UI */
        .yt-header {
            height: 70px;
            background: #0f0f0f;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            border-bottom: 1px solid #272727;
            gap: 20px;
        }
        .yt-logo {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: bold;
            font-size: 22px;
            color: #fff;
            cursor: pointer;
        }
        .yt-logo-icon {
            width: 32px;
            height: 22px;
            background: #ff0000;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .yt-logo-icon::after {
            content: "";
            border-style: solid;
            border-width: 5px 0 5px 9px;
            border-color: transparent transparent transparent #ffffff;
        }
        .yt-search-bar {
            display: flex;
            align-items: center;
            flex: 1;
            max-width: 600px;
            background: #121212;
            border: 1px solid #303030;
            border-radius: 40px;
            padding: 0 6px 0 18px;
            height: 46px;
        }
        .yt-search-input {
            flex: 1;
            background: transparent;
            border: none;
            outline: none;
            color: #ffffff;
            font-size: 16px;
        }
        .yt-search-btn {
            background: #222222;
            border: none;
            outline: none;
            width: 50px;
            height: 36px;
            border-radius: 0 20px 20px 0;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            color: #ffffff;
        }

        .yt-body {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
        }

        #player-wrapper {
            width: 100%;
            height: 380px;
            background: #000;
            display: none;
        }
        #player-wrapper iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .yt-feed {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .video-card {
            display: flex;
            flex-direction: column;
            gap: 10px;
            cursor: pointer;
            background: #181818;
            border-radius: 8px;
            overflow: hidden;
            padding-bottom: 10px;
        }
        .video-thumb {
            width: 100%;
            aspect-ratio: 16/9;
            background: #272727;
            object-fit: cover;
        }
        .video-info {
            padding: 0 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .video-title {
            font-size: 14px;
            font-weight: 500;
            color: #f1f1f1;
            line-clamp: 2;
            -webkit-line-clamp: 2;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.3;
        }
        .video-channel {
            font-size: 12px;
            color: #aaa;
        }

        .instruction-toast {
            position: absolute;
            top: 15px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.75);
            color: #fff;
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 13px;
            z-index: 100;
            pointer-events: none;
            border: 1px solid #444;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/renderers/CSS3DRenderer.js"></script>
</head>
<body>

    <div class="instruction-toast">Dùng tay/chuột xoay góc nhìn để thấy màn hình 3D được gắn trên sân trường</div>

    <div id="container3d"></div>
    <div id="containerCss"></div>

    <script>
        // --- 1. THREE.JS & CSS3D SETUP ---
        const width = window.innerWidth;
        const height = window.innerHeight;

        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x87ceeb);

        const camera = new THREE.PerspectiveCamera(60, width / height, 0.1, 1000);
        camera.position.set(0, 6, 16);

        // WebGL Renderer (Cho cảnh 3D)
        const renderer = new THREE.WebGLRenderer({ antialias: true });
        renderer.setSize(width, height);
        renderer.shadowMap.enabled = true;
        document.getElementById('container3d').appendChild(renderer.domElement);

        // CSS3D Renderer (Cho giao diện tương tác trực tiếp trên mặt phẳng 3D)
        const cssRenderer = new THREE.CSS3DRenderer();
        cssRenderer.setSize(width, height);
        document.getElementById('containerCss').appendChild(cssRenderer.domElement);

        const controls = new THREE.OrbitControls(camera, cssRenderer.domElement);
        controls.enableDamping = true;
        controls.maxPolarAngle = Math.PI / 2 - 0.05;

        // Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambientLight);

        const sunLight = new THREE.DirectionalLight(0xffffff, 0.8);
        sunLight.position.set(20, 40, 20);
        sunLight.castShadow = true;
        scene.add(sunLight);

        // Sân trường
        const groundGeo = new THREE.PlaneGeometry(50, 50);
        const groundMat = new THREE.MeshStandardMaterial({ color: 0x557a46 });
        const ground = new THREE.Mesh(groundGeo, groundMat);
        ground.rotation.x = -Math.PI / 2;
        ground.receiveShadow = true;
        scene.add(ground);

        // Các dãy nhà xung quanh
        function createBuilding(x, z, w, h, d, color) {
            const geo = new THREE.BoxGeometry(w, h, d);
            const mat = new THREE.MeshStandardMaterial({ color: color });
            const mesh = new THREE.Mesh(geo, mat);
            mesh.position.set(x, h/2, z);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            scene.add(mesh);
        }
        createBuilding(-12, -10, 10, 8, 6, 0xd9822b);
        createBuilding(12, -10, 10, 8, 6, 0x2b82d9);
        createBuilding(0, -18, 20, 10, 6, 0xeeeeee);

        // Cây xanh
        function createTree(x, z) {
            const trunkGeo = new THREE.CylinderGeometry(0.3, 0.4, 2);
            const trunkMat = new THREE.MeshStandardMaterial({ color: 0x5c4033 });
            const trunk = new THREE.Mesh(trunkGeo, trunkMat);
            trunk.position.set(x, 1, z);

            const leavesGeo = new THREE.ConeGeometry(1.5, 4, 8);
            const leavesMat = new THREE.MeshStandardMaterial({ color: 0x2e8b57 });
            const leaves = new THREE.Mesh(leavesGeo, leavesMat);
            leaves.position.set(x, 4, z);

            scene.add(trunk);
            scene.add(leaves);
        }
        createTree(-8, 4);
        createTree(8, 4);

        // Chân đế giữ màn hình 3D
        const standGeo = new THREE.BoxGeometry(10, 0.4, 1);
        const standMat = new THREE.MeshStandardMaterial({ color: 0x222222 });
        const stand = new THREE.Mesh(standGeo, standMat);
        stand.position.set(0, 0.2, -3);
        scene.add(stand);

        const poleGeo = new THREE.CylinderGeometry(0.2, 0.2, 5);
        const pole1 = new THREE.Mesh(poleGeo, standMat);
        pole1.position.set(-4, 2.5, -3);
        const pole2 = new THREE.Mesh(poleGeo, standMat);
        pole2.position.set(4, 2.5, -3);
        scene.add(pole1);
        scene.add(pole2);

        // --- 2. GẮN INTERFACE HTML VÀO BỀ MẶT MÀN HÌNH 3D ---
        const screenDiv = document.createElement('div');
        screenDiv.className = 'yt-3d-screen';
        screenDiv.innerHTML = `
            <div class="yt-header">
                <div class="yt-logo" onclick="loadDefaultFeed()">
                    <div class="yt-logo-icon"></div>
                    <span>YouTube</span>
                </div>
                <div class="yt-search-bar">
                    <input type="text" id="yt-input" class="yt-search-input" placeholder="Tìm kiếm trên màn hình 3D..." onkeypress="handleKeyPress(event)">
                    <button class="yt-search-btn" onclick="executeSearch()">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="yt-body">
                <div id="player-wrapper">
                    <iframe id="yt-iframe" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                <div id="yt-feed" class="yt-feed"></div>
            </div>
        `;

        // Chuyển HTML Element thành Vật thể CSS3D
        const cssObject = new THREE.CSS3DObject(screenDiv);
        // Định vị vị trí và kích thước màn hình trong không gian 3D
        cssObject.position.set(0, 5, -3);
        cssObject.scale.set(0.0065, 0.0065, 0.0065); // Tỷ lệ thu nhỏ vừa với khung cảnh 3D
        scene.add(cssObject);

        // Khung bảo vệ phía sau màn hình 3D (Tạo độ dày)
        const backGeo = new THREE.BoxGeometry(8.5, 4.8, 0.2);
        const backMat = new THREE.MeshStandardMaterial({ color: 0x111111 });
        const backMesh = new THREE.Mesh(backGeo, backMat);
        backMesh.position.set(0, 5, -3.11);
        scene.add(backMesh);

        // Resize
        window.addEventListener('resize', () => {
            const w = window.innerWidth;
            const h = window.innerHeight;
            camera.aspect = w / h;
            camera.updateProjectionMatrix();
            renderer.setSize(w, h);
            cssRenderer.setSize(w, h);
        });

        // Loop Render
        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
            cssRenderer.render(scene, camera);
        }
        animate();

        // --- 3. DỮ LIỆU VÀ XỬ LÝ NỘI DUNG YOUTUBE ---
        const sampleVideos = [
            { id: "dQw4w9WgXcQ", title: "Rick Astley - Never Gonna Give You Up (Official Music Video)", channel: "Rick Astley", thumb: "https://img.youtube.com/vi/dQw4w9WgXcQ/hqdefault.jpg" },
            { id: "kJQP7kiw5Fk", title: "Luis Fonsi - Despacito ft. Daddy Yankee", channel: "Luis Fonsi", thumb: "https://img.youtube.com/vi/kJQP7kiw5Fk/hqdefault.jpg" },
            { id: "JGwWNGJdvx8", title: "Ed Sheeran - Shape of You (Official Music Video)", channel: "Ed Sheeran", thumb: "https://img.youtube.com/vi/JGwWNGJdvx8/hqdefault.jpg" },
            { id: "OPf0YbXqDm0", title: "Mark Ronson - Uptown Funk ft. Bruno Mars", channel: "Mark Ronson", thumb: "https://img.youtube.com/vi/OPf0YbXqDm0/hqdefault.jpg" },
            { id: "3tmd-ClpJxA", title: "Lofi Hip Hop Radio - Beats to Relax/Study to", channel: "Lofi Girl", thumb: "https://img.youtube.com/vi/jfKfPfyJRdk/hqdefault.jpg" },
            { id: "2Vv-BfVoq4g", title: "Ed Sheeran - Perfect (Official Music Video)", channel: "Ed Sheeran", thumb: "https://img.youtube.com/vi/2Vv-BfVoq4g/hqdefault.jpg" }
        ];

        function renderFeed(list) {
            const feedContainer = document.getElementById('yt-feed');
            feedContainer.innerHTML = '';
            list.forEach(item => {
                const card = document.createElement('div');
                card.className = 'video-card';
                card.onclick = () => playVideo(item.id);
                card.innerHTML = `
                    <img class="video-thumb" src="${item.thumb}" alt="thumbnail">
                    <div class="video-info">
                        <div class="video-title">${item.title}</div>
                        <div class="video-channel">${item.channel}</div>
                    </div>
                `;
                feedContainer.appendChild(card);
            });
        }

        function playVideo(id) {
            const playerWrapper = document.getElementById('player-wrapper');
            const iframe = document.getElementById('yt-iframe');
            iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
            playerWrapper.style.display = 'block';
        }

        function executeSearch() {
            const query = document.getElementById('yt-input').value.trim();
            if(!query) return;
            
            const filtered = sampleVideos.filter(v => v.title.toLowerCase().includes(query.toLowerCase()) || v.channel.toLowerCase().includes(query.toLowerCase()));
            
            if(filtered.length > 0) {
                renderFeed(filtered);
            } else {
                renderFeed([
                    { id: "dQw4w9WgXcQ", title: `Kết quả tìm kiếm: ${query}`, channel: "YouTube Search", thumb: "https://img.youtube.com/vi/dQw4w9WgXcQ/hqdefault.jpg" },
                    ...sampleVideos
                ]);
            }
        }

        function handleKeyPress(e) {
            if(e.key === 'Enter') {
                executeSearch();
            }
        }

        function loadDefaultFeed() {
            document.getElementById('player-wrapper').style.display = 'none';
            document.getElementById('yt-iframe').src = '';
            document.getElementById('yt-input').value = '';
            renderFeed(sampleVideos);
        }

        loadDefaultFeed();
    </script>
</body>
</html>
