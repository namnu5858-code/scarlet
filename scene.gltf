<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Vampire Sunflower - 3D Game</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: #0b1d0b;
            touch-action: none;
            font-family: sans-serif;
            -webkit-user-select: none;
            user-select: none;
        }
        #canvas-container {
            width: 100vw;
            height: 100vh;
            display: block;
        }
        /* Giao diện UI Điều khiển */
        .ui-container {
            position: absolute;
            bottom: 25px;
            left: 25px;
            width: 110px;
            height: 110px;
            background: rgba(255, 255, 255, 0.08);
            border: 1.5px solid rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            touch-action: none;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        .ui-knob {
            width: 45px;
            height: 45px;
            background: rgba(255, 255, 255, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 50%;
            position: absolute;
            pointer-events: none;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            transition: background 0.2s;
        }
        #jump-btn {
            position: absolute;
            bottom: 35px;
            right: 35px;
            width: 65px;
            height: 65px;
            background: rgba(255, 255, 255, 0.12);
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 24px;
            font-weight: bold;
            touch-action: none;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }
        #jump-btn:active {
            background: rgba(255, 255, 255, 0.3);
        }
        #loading {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #fff;
            font-size: 16px;
            background: rgba(0,0,0,0.7);
            padding: 12px 24px;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.2);
            pointer-events: none;
            transition: opacity 0.3s;
        }
    </style>
</head>
<body>
    <div id="loading">Đang tải Vampire Sunflower...</div>
    <div id="canvas-container"></div>

    <!-- Joystick -->
    <div class="ui-container" id="joystick-container">
        <div class="ui-knob" id="joystick-knob"></div>
    </div>

    <!-- Nút Nhảy -->
    <div id="jump-btn">▲</div>

    <!-- Three.js & GLTFLoader r128 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

    <script>
        let scene, camera, renderer, model;
        let mixer;
        const clock = new THREE.Clock();

        let moveX = 0;
        let moveZ = 0;
        const moveSpeed = 3.5;
        let currentRotationY = 0;
        let targetRotationY = 0;

        let isJumping = false;
        let verticalVelocity = 0;
        const gravity = -15;
        const jumpForce = 6;
        const groundY = 0;

        let leafParts = [];
        let rootParts = [];
        let stemPart = null;
        let headPart = null;

        const keys = { w: false, a: false, s: false, d: false };

        init();
        animate();

        function init() {
            scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0f1f12);
            scene.fog = new THREE.FogExp2(0x0f1f12, 0.025);

            camera = new THREE.PerspectiveCamera(55, window.innerWidth / window.innerHeight, 0.1, 100);
            camera.position.set(0, 3, 5);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.shadowMap.enabled = true;
            renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            const ambientLight = new THREE.AmbientLight(0xdff0df, 1.2);
            scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xfffaed, 1.8);
            dirLight.position.set(6, 12, 6);
            dirLight.castShadow = true;
            dirLight.shadow.mapSize.width = 1024;
            dirLight.shadow.mapSize.height = 1024;
            dirLight.shadow.bias = -0.001;
            scene.add(dirLight);

            const fillLight = new THREE.DirectionalLight(0x739673, 0.6);
            fillLight.position.set(-6, 5, -6);
            scene.add(fillLight);

            const groundGeo = new THREE.PlaneGeometry(100, 100);
            const groundMat = new THREE.MeshStandardMaterial({ 
                color: 0x2e4f2f, 
                roughness: 0.8,
                metalness: 0.1
            });
            const ground = new THREE.Mesh(groundGeo, groundMat);
            ground.rotation.x = -Math.PI / 2;
            ground.receiveShadow = true;
            scene.add(ground);

            const grid = new THREE.GridHelper(100, 50, 0x4a7c4a, 0x243b24);
            grid.position.y = 0.01;
            scene.add(grid);

            const loader = new THREE.GLTFLoader();
            loader.load('scene.gltf', (gltf) => {
                model = gltf.scene;
                model.scale.set(1, 1, 1);
                model.position.set(0, groundY, 0);

                model.traverse((child) => {
                    if (child.isMesh) {
                        child.castShadow = true;
                        child.receiveShadow = true;
                    }
                    const name = child.name.toLowerCase();
                    if (name.includes('leaf') || name.includes('la')) {
                        leafParts.push(child);
                    } else if (name.includes('root') || name.includes('re')) {
                        rootParts.push(child);
                    } else if (name.includes('stem') || name.includes('than')) {
                        stemPart = child;
                    } else if (name.includes('head') || name.includes('flower') || name.includes('face') || name.includes('hoa')) {
                        headPart = child;
                    }
                });

                scene.add(model);

                if (gltf.animations && gltf.animations.length > 0) {
                    mixer = new THREE.AnimationMixer(model);
                    const action = mixer.clipAction(gltf.animations[0]);
                    action.play();
                }

                const loadEl = document.getElementById('loading');
                loadEl.style.opacity = '0';
                setTimeout(() => loadEl.remove(), 300);

            }, undefined, (error) => {
                console.error('Lỗi khi tải model scene.gltf:', error);
                document.getElementById('loading').innerText = 'Không thể tải mô hình scene.gltf!';
            });

            initControls();
            window.addEventListener('resize', onWindowResize);
        }

        function initControls() {
            const container = document.getElementById('joystick-container');
            const knob = document.getElementById('joystick-knob');
            const maxDist = 38;

            let active = false;
            let centerX = 0;
            let centerY = 0;

            container.addEventListener('pointerdown', (e) => {
                active = true;
                const rect = container.getBoundingClientRect();
                centerX = rect.left + rect.width / 2;
                centerY = rect.top + rect.height / 2;
            });

            window.addEventListener('pointermove', (e) => {
                if (!active) return;
                const dx = e.clientX - centerX;
                const dy = e.clientY - centerY;
                const dist = Math.min(Math.sqrt(dx * dx + dy * dy), maxDist);
                const angle = Math.atan2(dy, dx);

                const kx = Math.cos(angle) * dist;
                const ky = Math.sin(angle) * dist;
                knob.style.transform = `translate(${kx}px, ${ky}px)`;

                moveX = kx / maxDist;
                moveZ = ky / maxDist;
            });

            const stopJoystick = () => {
                if (!active) return;
                active = false;
                knob.style.transform = `translate(0px, 0px)`;
                moveX = 0;
                moveZ = 0;
            };

            window.addEventListener('pointerup', stopJoystick);
            window.addEventListener('pointercancel', stopJoystick);

            const jumpBtn = document.getElementById('jump-btn');
            jumpBtn.addEventListener('pointerdown', (e) => {
                e.preventDefault();
                triggerJump();
            });

            window.addEventListener('keydown', (e) => {
                if (e.key === 'w' || e.key === 'ArrowUp') keys.w = true;
                if (e.key === 's' || e.key === 'ArrowDown') keys.s = true;
                if (e.key === 'a' || e.key === 'ArrowLeft') keys.a = true;
                if (e.key === 'd' || e.key === 'ArrowRight') keys.d = true;
                if (e.key === ' ' || e.key === 'Spacebar') triggerJump();
                updateKeyboardMovement();
            });

            window.addEventListener('keyup', (e) => {
                if (e.key === 'w' || e.key === 'ArrowUp') keys.w = false;
                if (e.key === 's' || e.key === 'ArrowDown') keys.s = false;
                if (e.key === 'a' || e.key === 'ArrowLeft') keys.a = false;
                if (e.key === 'd' || e.key === 'ArrowRight') keys.d = false;
                updateKeyboardMovement();
            });
        }

        function updateKeyboardMovement() {
            let x = 0, z = 0;
            if (keys.w) z -= 1;
            if (keys.s) z += 1;
            if (keys.a) x -= 1;
            if (keys.d) x += 1;
            if (x !== 0 && z !== 0) {
                x *= 0.7071;
                z *= 0.7071;
            }
            moveX = x;
            moveZ = z;
        }

        function triggerJump() {
            if (!isJumping && model && model.position.y <= groundY + 0.01) {
                isJumping = true;
                verticalVelocity = jumpForce;
            }
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);

            const delta = clock.getDelta();
            const time = clock.getElapsedTime();

            if (mixer) mixer.update(delta);

            if (model) {
                const isMoving = (moveX !== 0 || moveZ !== 0);

                if (isMoving) {
                    targetRotationY = Math.atan2(moveX, moveZ);
                }

                let diff = targetRotationY - currentRotationY;
                while (diff < -Math.PI) diff += Math.PI * 2;
                while (diff > Math.PI) diff -= Math.PI * 2;
                currentRotationY += diff * 10 * delta;
                model.rotation.y = currentRotationY;

                if (isMoving) {
                    model.position.x += moveX * moveSpeed * delta;
                    model.position.z += moveZ * moveSpeed * delta;
                }

                if (isJumping || model.position.y > groundY) {
                    verticalVelocity += gravity * delta;
                    model.position.y += verticalVelocity * delta;

                    if (model.position.y <= groundY) {
                        model.position.y = groundY;
                        isJumping = false;
                        verticalVelocity = 0;
                    }
                }

                if (isMoving && !isJumping) {
                    model.position.y = groundY + Math.abs(Math.sin(time * 14)) * 0.08;
                    model.rotation.z = Math.sin(time * 14) * 0.04;
                    model.rotation.x = Math.cos(time * 14) * 0.04;
                } else if (!isJumping) {
                    model.position.y = groundY + Math.sin(time * 2) * 0.02;
                    model.rotation.z = THREE.MathUtils.lerp(model.rotation.z, 0, 10 * delta);
                    model.rotation.x = THREE.MathUtils.lerp(model.rotation.x, 0, 10 * delta);
                } else {
                    model.rotation.z = 0;
                    model.rotation.x = 0.1;
                }

                const targetCameraX = model.position.x - Math.sin(currentRotationY) * 3.5;
                const targetCameraZ = model.position.z - Math.cos(currentRotationY) * 3.5;
                const targetCameraY = model.position.y + 2.2;

                camera.position.x += (targetCameraX - camera.position.x) * 8 * delta;
                camera.position.y += (targetCameraY - camera.position.y) * 8 * delta;
                camera.position.z += (targetCameraZ - camera.position.z) * 8 * delta;

                camera.lookAt(new THREE.Vector3(
                    model.position.x,
                    model.position.y + 1.1,
                    model.position.z
                ));
            }

            renderer.render(scene, camera);
        }
    </script>
</body>
</html>
